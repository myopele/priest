  <script>
    const boxes = document.querySelectorAll('input[type="checkbox"][data-week]');
    const progressText = document.getElementById('progressText');
    const progressFill = document.getElementById('progressFill');

    function loadProgress(){
      boxes.forEach(box => {
        const week = box.getAttribute('data-week');
        box.checked = localStorage.getItem('sgi-universal-priesthood-week-' + week) === 'true';
      });
      updateProgress();
    }

    function updateProgress(){
      const total = boxes.length;
      const completed = Array.from(boxes).filter(box => box.checked).length;
      const percent = total ? Math.round((completed / total) * 100) : 0;
      progressText.textContent = completed + ' of ' + total + ' modules completed';
      progressFill.style.width = percent + '%';
    }

    boxes.forEach(box => {
      box.addEventListener('change', () => {
        const week = box.getAttribute('data-week');
        localStorage.setItem('sgi-universal-priesthood-week-' + week, box.checked);
        updateProgress();
      });
    });

    loadProgress();
  </script>
